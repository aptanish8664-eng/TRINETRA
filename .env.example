# Optional local override; by default the backend uses backend/trinetra.db.
# TRINETRA_DB_PATH=

# Optional SQLAlchemy URL for PostgreSQL. When unset, TRINETRA uses local SQLite.
# PostgreSQL uses Psycopg 3 and requires libpq on the backend host; schema upgrades require `alembic upgrade head` first.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/database

# Optional seed-disjoint research classifier JSON artifact, stored inside this workspace.
# By default the validated heuristic detector remains active.
# TRINETRA_ML_MODEL_PATH=backend/research-data/models/<model-id>/model.json

# Match the origin used in the browser. Keep one hostname consistently.
TRINETRA_ALLOWED_ORIGINS=http://127.0.0.1:5173
TRINETRA_SESSION_COOKIE_SECURE=true

# AI remains disabled until an owner configures a secret in the local .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
TRINETRA_AI_TIMEOUT_SECONDS=20
TRINETRA_AI_MAX_INPUT_CHARS=6000
TRINETRA_AI_MAX_OUTPUT_TOKENS=1800
TRINETRA_AI_REQUESTS_PER_HOUR=20
TRINETRA_AI_DAILY_OUTPUT_TOKEN_LIMIT=20000

# Request-body size bound.
TRINETRA_MAX_HTTP_BODY_BYTES=65536

# Optional read-only PX4 MAVLink telemetry ingress. Leave disabled unless the
# WSL loopback UDP bridge is running and the WSL source IP/port are verified.
TRINETRA_PX4_UDP_ENABLED=false
TRINETRA_PX4_UDP_BIND_HOST=172.23.80.1
TRINETRA_PX4_UDP_BIND_PORT=14600
TRINETRA_PX4_UDP_ALLOWED_SOURCE_IP=172.23.85.230
TRINETRA_PX4_UDP_ALLOWED_SOURCE_PORT=14601

# Optional read-only Gazebo /world/<world>/pose/info relay for the in-page
# X500 pose mirror. This is a second UDP socket, separate from PX4 MAVLink.
TRINETRA_GAZEBO_POSE_UDP_ENABLED=false
TRINETRA_GAZEBO_POSE_UDP_BIND_HOST=172.23.80.1
TRINETRA_GAZEBO_POSE_UDP_BIND_PORT=14610
TRINETRA_GAZEBO_POSE_UDP_ALLOWED_SOURCE_IP=172.23.85.230
TRINETRA_GAZEBO_POSE_UDP_ALLOWED_SOURCE_PORT=14611
